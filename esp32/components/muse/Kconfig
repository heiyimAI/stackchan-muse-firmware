    config MUSE_ENABLED
        bool
        default y if !MUSE_BOARD_NONE

    # Always defined, unlike the target-dependent board options, so
    # idf_component.yml rules can select each board's managed components.
    config MUSE_BOARD_ID
        string
        default "waveshare_s3_175c" if MUSE_BOARD_WAVESHARE_S3_175C
        default "waveshare_s3_175" if MUSE_BOARD_WAVESHARE_S3_175
        default "ostb_echoear_2st" if MUSE_BOARD_OSTB_ECHOEAR_2ST
        default "waveshare_s3_216" if MUSE_BOARD_WAVESHARE_S3_216
        default "waveshare_s3_185c" if MUSE_BOARD_WAVESHARE_S3_185C
        default "aipi" if MUSE_BOARD_AIPI
        default "espressif_box_3" if MUSE_BOARD_ESPRESSIF_BOX_3
        default "waveshare_c6_18" if MUSE_BOARD_WAVESHARE_C6_18
        default "waveshare_c6_206" if MUSE_BOARD_WAVESHARE_C6_206
        default "sensecap_watcher" if MUSE_BOARD_SENSECAP_WATCHER
        default "m5stack_sticks3" if MUSE_BOARD_M5STACK_STICKS3
        default "m5stack_stickc_plus2" if MUSE_BOARD_M5STACK_STICKC_PLUS2
        default "m5stack_cardputer_adv" if MUSE_BOARD_M5STACK_CARDPUTER_ADV
        default "m5stack_stopwatch" if MUSE_BOARD_M5STACK_STOPWATCH
        default "m5stack_cores3" if MUSE_BOARD_M5STACK_CORES3
        default "m5stack_core2" if MUSE_BOARD_M5STACK_CORE2
        default "fnk0104b" if MUSE_BOARD_FNK0104B
        default "guition_jc3248w535" if MUSE_BOARD_GUITION_JC3248W535
        default "waveshare_s3_lcd7" if MUSE_BOARD_WAVESHARE_S3_LCD7
        default "vn_s3_183" if MUSE_BOARD_VN_S3_183
        default "ai_passport" if MUSE_BOARD_AI_PASSPORT
        default "none"

    # The Muse tools' serial port: the console UART behind the board's USB
    # bridge, where the chip's own USB Serial/JTAG isn't wired to a connector
    # (the Watcher's USB-C goes to a CH342) or the chip has none.
    config MUSE_CONSOLE_UART
        bool
        default y if MUSE_BOARD_SENSECAP_WATCHER || MUSE_BOARD_WAVESHARE_S3_LCD7 || !SOC_USB_SERIAL_JTAG_SUPPORTED

    # A board overlay can raise this for a quiet speaker.
    config MUSE_DEFAULT_VOLUME
        int "Speaker volume until one is chosen in settings (percent)"
        range 0 100
        default 70

    config MUSE_POWER_TEST
        bool "Isolated board BSP power-characterization firmware"
        # Boards implementing boards/muse_power_test_board.h; extend this list
        # only after the new board's diagnostic hooks and matrix pass tests.
        depends on (MUSE_BOARD_SENSECAP_WATCHER) && PM_ENABLE && FREERTOS_USE_TICKLESS_IDLE
        default n
        help
            DIAGNOSTIC ONLY: bypass Home Link and the Muse UI/voice application
            at app_main. USB UART arms a timed autonomous VBUS-free BSP-load
            sweep. No credentials, production NVS, BLE provisioning or OTA.
            Results are retained in RAM/RTC until read back after USB reconnect.
            This characterizes isolated BSP loads, NOT production power.
            Optional camera support is not required and unsupported matrix
            features are explicitly skipped. Never enable in a release profile.

    config MUSE_WATCHER_CAMERA
        bool "SenseCAP Watcher camera capture and live preview"
        depends on MUSE_BOARD_SENSECAP_WATCHER && SPIRAM
        default n
        help
            Enable the camera.capture Home Link command and the wheel
            double-click camera preview. Camera buffers and tasks consume
            memory and preview decoding shares CPU time with voice and Link.
            Leave disabled to build without camera support.

    config MUSE_CJK_FONT
        bool "Show Chinese and Japanese in captions"
        depends on MUSE_ENABLED
        default n
        help
            Captions fall back to GNU Unifont's 16x16 bitmaps for CJK
            punctuation, kana, the CJK Unified Ideographs and fullwidth
            forms that the ASCII caption font lacks. Small screens, whose
            captions are two lines of 8 px text, show a reply with CJK in it
            one 16 px line at a time. Takes about 850 KB of flash and no RAM.
            Without it those characters show as boxes. Hangul isn't
            included.

    config MUSE_JC3248W535_MIC_GPIO
        int "JC3248W535: GPIO for an external I2S mic's data (SD) line"
        depends on MUSE_BOARD_GUITION_JC3248W535
        range -1 48
        default -1
        help
            The board has a speaker amp but no microphone. Wire an I2S MEMS
            mic such as an INMP441 to the speaker's clocks (SCK to GPIO42, WS
            to GPIO2), L/R to GND, power to 3.3 V, and its SD line to a free
            GPIO, and set that GPIO here. -1 leaves push-to-talk recording
            silence.

    config MUSE_STATIC_BUFFERS_IN_PSRAM
        bool "Keep the avatar's and audio's static buffers in PSRAM"
        depends on MUSE_ENABLED && SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY
        default n
        help
            Places the zero-initialized statics of the avatar renderer
            (muse_pixel.c: its frame, mask and lookup tables) and the audio
            path (muse_audio.c: the I2S staging and chirp buffers), about
            17 KB, in PSRAM instead of internal RAM (linker.lf). Only the
            CPU touches them: the avatar is scaled into LVGL's draw buffer,
            and the I2S driver copies to and from its own DMA buffers. Turn
            it on where internal RAM is short, as the SenseCAP Watcher does
            to pay for the CPU's light-sleep retention memory, which it
            takes at boot and keeps.

    config MUSE_HATCH
        bool "Muse's own voice session"
        depends on MUSE_ENABLED
        default y if SPIRAM
        default n
        help
            Push-to-talk turns go over a voice session of Muse's own, to the
            VM Home Link is paired with or one set up on the device with a
            device token. Replies are text, shown as captions; start_tts in
            muse_chat_session.cpp is where a TTS API of your own can speak
            them. Needs PSRAM. Without it, voice notes go over Home Link's own
            session to its paired VM and replies are shown as text.

    config MUSE_TTS_VOICEPROXY_URL
        string "voice-proxy TTS endpoint base URL"
        depends on MUSE_HATCH
        default ""
        help
            Base URL of the self-hosted voice-proxy (e.g. https://voice-proxy.example.com).
            Feeds both the TTS hook (POST /v1/tts) and, with MUSE_STT_VOICEPROXY,
            speech-to-text (POST /v1/stt). Empty disables both and falls back to
            silent caption pacing / Muse-side transcription.

    config MUSE_TTS_VOICEPROXY_TOKEN
        string "Bearer token for voice-proxy"
        depends on MUSE_HATCH
        default ""

    config MUSE_TTS_VOICEPROXY_VOICE
        string "voice_id passed to voice-proxy (MiniMax voice alias)"
        depends on MUSE_HATCH
        default "Cantonese_GentleLady"

    config MUSE_STT_VOICEPROXY
        bool "Transcribe on the voice-proxy instead of Muse"
        depends on MUSE_HATCH
        default y
        help
            Push-to-talk records locally and posts the raw PCM to the
            voice-proxy /v1/stt (lang=yue); the transcript is injected into
            the chat as a turn whose reply is captioned and spoken. Muse then
            only answers. Off: the voice note goes to Muse, as upstream does,
            and Muse transcribes it.

    # The voice-detection block below sets how a note that no finger releases
    # ends: a wake word or any other voice-triggered turn. Push-to-talk is
    # unaffected — the button decides when a note ends.

    config MUSE_VAD_DROP_DB
        int "Speech end: dB below the speech peak"
        depends on MUSE_HATCH
        range 6 40
        default 18
        help
            A chunk under (the loudest chunk of the note - this) is silence.
            Too small and a normal pause in speech ends the note early; too
            large and the note runs on through the room's noise. This is the
            usual end-of-speech hangover of 10-20 dB.

    config MUSE_VAD_FLOOR_DB
        int "Speech end: absolute floor (negative dBFS)"
        depends on MUSE_HATCH
        range -80 -30
        default -45
        help
            The threshold above never drops below this, so the room's noise
            floor cannot count as speech — which, in most rooms, is what this
            setting really is: the level a voice has to beat. Too low and the
            room talks over the speaker; too high and a soft voice is never
            heard at all.

            Measured on a CoreS3 at the default 30 dB mic gain: a voice reads
            about -40 dBFS over a whole note (rms), and the room between its
            words -52 to -68 dBFS. This default sits in that gap. Every
            voice-triggered note logs the two numbers to compare —
                muse_voice: voice: peak X dBFS, threshold Y dBFS, armed
            where Y is this floor until the peak outgrows it (-27 dBFS and
            louder), and only chunks that reach Y count as speech at all.

    config MUSE_VAD_MIN_SPEECH_CHUNKS
        int "Speech chunks before the end can fire (20 ms each)"
        depends on MUSE_HATCH
        range 1 100
        default 15
        help
            300 ms of speech, counted in all rather than in a row: the dip
            between two words must not keep a quiet speaker from ever arming,
            which would run their note to the 15 s cap. Until this much has
            been heard, silence cannot end the note — a cough, a door, or the
            wake phrase's own beep cannot cut a note short before it begins.

    config MUSE_VAD_SILENCE_CHUNKS
        int "Silent chunks that end the note (20 ms each)"
        depends on MUSE_HATCH
        range 1 150
        default 15
        help
            300 ms of silence ends the note. This is added latency at the end
            of every turn; shortening it makes the robot feel quicker to
            answer and risks clipping the last word.

    config MUSE_VAD_NO_SPEECH_MS
        int "Voice-triggered turn abandoned after (ms of no speech)"
        depends on MUSE_HATCH
        range 1000 30000
        default 5000
        help
            A wake word that caught something other than a person — a
            television, a cough — must not sit recording for the full 15 s
            cap with the mic light on. After this long with nothing above the
            floor, the turn is cancelled with the usual DIDN'T CATCH THAT.
            Push-to-talk ignores this: a held button means intent.

    config MUSE_VAD_PREROLL_CHUNKS
        int "Audio kept from before the trigger (20 ms each)"
        depends on MUSE_HATCH
        range 0 25
        default 4
        help
            80 ms of the ring buffer is kept when a voice-triggered turn
            begins, so the first syllable after the wake word is not clipped
            while the trigger travels to the voice task. The wake phrase
            itself is discarded with the rest of the ring.

endmenu
